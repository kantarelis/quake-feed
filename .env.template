# ============================================================================
# quake-feed environment template
# Copy to .env via `make install-env`, then edit for your local setup.
# All defaults below are safe for a local docker-compose run.
# ============================================================================

# ----------------------------------------------------------------------------
# Runtime
# ----------------------------------------------------------------------------
ENVIRONMENT="development"
APPLICATION_NAME="quake-feed"

# ----------------------------------------------------------------------------
# Backend (FastAPI / Uvicorn)
# ----------------------------------------------------------------------------
QUAKE_HOST_IP="0.0.0.0"
QUAKE_BIND_PORT=8000

# ----------------------------------------------------------------------------
# Database (TimescaleDB / PostgreSQL)
# Hostnames refer to docker-compose service names.
# ----------------------------------------------------------------------------
DB_USERNAME="quake"
DB_PASSWORD="quake"
DB_NAME="quake-db"
DB_HOST="postgres-db"
DB_PORT=5432

# ----------------------------------------------------------------------------
# Logging (Loki)
# ----------------------------------------------------------------------------
LOGGER_NAME="quake-feed-logger"
LOGGER_LOG_LEVEL=10
LOKI_HOST="loki"
LOKI_PORT=3100

# ----------------------------------------------------------------------------
# Prometheus
# ----------------------------------------------------------------------------
PROMETHEUS_HOST="prometheus"
PROMETHEUS_PORT=9090

# ----------------------------------------------------------------------------
# Celery worker metrics
# - The worker exposes its Prometheus registry on this port; prometheus.yml
#   scrapes it as the `celery_worker:8001` target (keep the two in sync).
# ----------------------------------------------------------------------------
WORKER_METRICS_PORT=8001

# ----------------------------------------------------------------------------
# Grafana
# ----------------------------------------------------------------------------
GRAFANA_HOST="grafana"
GRAFANA_PORT=3000
GF_SECURITY_ADMIN_USER="admin"
GF_SECURITY_ADMIN_PASSWORD="quake"

# ----------------------------------------------------------------------------
# RabbitMQ (Celery broker)
# ----------------------------------------------------------------------------
RABBITMQ_HOST="rabbitmq"
RABBITMQ_USERNAME="guest"
RABBITMQ_PASSWORD="guest"
RABBITMQ_AMQP_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# ----------------------------------------------------------------------------
# HashiCorp Vault (dev-mode container)
# - VAULT_DEV_ROOT_TOKEN_ID is only used in dev mode.
# - VAULT_UNSEAL_KEYS is a comma-separated list; populated after `make vault-init`.
# - VAULT_TOKEN is required for `make vault-seal` and admin operations.
# ----------------------------------------------------------------------------
VAULT_HOST="vault"
VAULT_PORT=8200
VAULT_DEV_ROOT_TOKEN_ID="root-token"
VAULT_UNSEAL_KEYS=""
VAULT_TOKEN=""
