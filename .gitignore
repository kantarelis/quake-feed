# ---------------------------------------------------------------------------
# Working / planning documents (local-only, never pushed)
# ---------------------------------------------------------------------------
vault_init_output.txt
postgres.session.sql

# ---------------------------------------------------------------------------
# Environment / secrets
# ---------------------------------------------------------------------------
.env
.env.local
.env.*.local

# ---------------------------------------------------------------------------
# Generated artifacts (regenerable on demand)
# ---------------------------------------------------------------------------
database/schema.sql
# dbmate's default schema-dump path when --schema-file isn't passed
# (e.g. someone runs `dbmate up` manually outside the Makefile). The
# Makefile always passes --schema-file, but this catches drift.
database/db/

# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
env/
build/
dist/
*.egg-info/
*.egg
.eggs/
pip-wheel-metadata/
share/python-wheels/

# Test / coverage artifacts
.pytest_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/
.cache/

# Type checker caches
.mypy_cache/
.pyre/
.pytype/
.dmypy.json
dmypy.json

# Lint caches
.ruff_cache/

# ---------------------------------------------------------------------------
# Node / frontend
# ---------------------------------------------------------------------------
node_modules/
frontend/dist/
frontend/.vite/
frontend/coverage/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# A global gitignore on some dev machines drops package-lock.json. Force it
# back in: npm ci (local `make frontend-install` + the CI `frontend` job) needs
# the committed lockfile for reproducible installs.
!frontend/package-lock.json

# ---------------------------------------------------------------------------
# Docker
# ---------------------------------------------------------------------------
docker-compose.override.yml

# ---------------------------------------------------------------------------
# Editor / OS
# ---------------------------------------------------------------------------
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ---------------------------------------------------------------------------
# Misc
# ---------------------------------------------------------------------------
*.log
